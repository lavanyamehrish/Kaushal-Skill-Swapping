{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "cd kaushal-backend/express-backend && npm install"
  },
  "deploy": {
    "startCommand": "cd kaushal-backend/express-backend && node server.js",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5
  }
}
