{
  "name": "kaushal",
  "version": "1.0.0",
  "description": "Project Kaushal - Skill Swapping Platform",
  "private": true,
  "workspaces": [
    "kaushal-frontend",
    "kaushal-backend/express-backend"
  ],
  "scripts": {
    "dev:frontend": "cd kaushal-frontend && npm run dev",
    "dev:backend": "cd kaushal-backend/express-backend && node server.js",
